{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "pages/**",
      "partials/**",
      "tools/**",
      "assets/brand/logo-v2-full.png",
      "assets/brand/favicon-source.png",
      "assets/brand/photo-originals/**",
      "*.md",
      "README.md",
      "_build/**",
      "*.zip"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/demolition-washington-dc",
        "destination": "/areas-we-serve",
        "type": 301
      },
      {
        "source": "/demolition-washington-dc.html",
        "destination": "/areas-we-serve",
        "type": 301
      },
      {
        "source": "/index",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/home",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/quote",
        "destination": "/contact",
        "type": 301
      },
      {
        "source": "/residential",
        "destination": "/residential-demolition",
        "type": 301
      },
      {
        "source": "/interior",
        "destination": "/interior-demolition",
        "type": 301
      },
      {
        "source": "/commercial",
        "destination": "/commercial-demolition",
        "type": 301
      }
    ]
  }
}
